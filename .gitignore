# Godot 4+ specific ignores
.godot/
/android/

**/__pycache__/

# Extracted PopCap art: regenerate with tools/extract_prefabs.py.
# Not committed for the same reason the audio is not - see art/README.md.
/art/*
!/art/README.md

# Built FMOD banks in audio/banks/ are committed (through LFS) by the
# "Update FMOD banks" workflow - see Music/docs/BUILD_RUNNER.md.
